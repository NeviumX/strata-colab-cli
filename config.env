# strata-colab-cli の設定。各スクリプトが bash で source する。
# API_KEY などの秘密の値は config.local.env に書くと上書きできる。config.local.env は .gitignore 済み。

# ===== Colab ランタイム =====
COLAB_SESSION=strata          # colab CLI のセッション名。ssh_config の ProxyCommand にも渡る
GPU=A100                      # T4 / L4 / G4 / H100 / A100
HIGH_MEM=1                    # 1 なら --high-mem を付ける。Colab Pro/Pro+ が必要
EXPECT_GPU_REGEX='A100'       # nvidia-smi の GPU 名がこれに一致しないときは ON_GPU_MISMATCH に従う
ON_GPU_MISMATCH=ask           # ask: 確認する / stop: ランタイムを止めて終了 / continue: そのまま続行

# ===== Colab VM 側の Strata =====
STRATA_REPO=https://github.com/Niko1221/Strata.git
MODEL=IQ3_S                   # Q2_0 / IQ2_XS / IQ3_XXS / IQ3_S など
CONTEXT=16384
REMOTE_PORT=8089              # Colab VM 側のポート。8080 は Colab が使っていることがある
API_KEY=                      # 空ならキーなし。SSH トンネル経由で手元にだけ出すので通常は不要
STRATA_EXTRA_ARGS=''          # setup.sh に追加で渡す引数。例: '--vision yes'
REMOTE_DIR=/content/Strata
DATA_DIR=/content/Strata-data # モデルの保存先。ランタイムを止めると消える
REMOTE_LOG=/content/strata-setup.log

# ===== 手元の WSL / Windows =====
STRATA_LANG="${STRATA_LANG:-}" # 表示する言語。空なら自動で、日本語の環境なら ja、それ以外は en。ja か en で固定できる
LOCAL_PORT=8080               # http://localhost:<この番号> で WebUI と API を使う
OPEN_BROWSER=1                # 1 なら起動完了時に Windows のブラウザで WebUI を開く
HEALTH_TIMEOUT_MIN=60         # 起動完了を待つ上限の分数。初回はダウンロードで 20〜30 分かかる
POLL_SEC=20                   # 起動待ちの確認間隔の秒数
SETUP_RETRIES=2               # setup.sh がポート使用中などで落ちたときに Colab 側でやり直す回数
WATCH_SEC=30                  # 起動後に Strata が落ちていないか確認する間隔の秒数
